{
  "name": "anatomy",
  "private": true,
  "version": "0.1.0",
  "description": "A local browser app that turns a plan, feature, or project into a map you can explore, question, and mark up.",
  "author": "Filip Snitil",
  "license": "MIT",
  "homepage": "https://github.com/snitilf/Anatomy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snitilf/Anatomy.git"
  },
  "bugs": {
    "url": "https://github.com/snitilf/Anatomy/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browsers": "playwright test -c playwright.browsers.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "schema": "node scripts/generate-schema.ts",
    "outlines": "node scripts/generate-outlines.ts",
    "tokens": "node scripts/tokens.ts",
    "eval": "node eval/run.ts",
    "agent-files": "node scripts/agent-files.ts",
    "anatomy": "node bin/anatomy.ts",
    "readme-images": "node scripts/readme-images.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@xyflow/react": "12.12.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.72.0",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
